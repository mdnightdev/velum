{
  "name": "velum",
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude 'server/db/**' --exclude 'server/logs/**' server/index.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "tsc --noEmit",
    "heal": "tsx server/self-healing.ts",
    "dev:server": "tsx watch server/index.ts",
    "cli": "tsx cli/v2/index.ts",
    "cli:v2": "tsx cli/v2/index.ts",
    "backup": "bash server/v2/scripts/backup.sh",
    "restore": "bash server/v2/scripts/restore.sh",
    "sync-to-cloud": "bash server/v2/scripts/sync-to-cloud.sh",
    "sync-from-cloud": "bash server/v2/scripts/sync-from-cloud.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@signalapp/libsignal-client": "^0.101.0",
    "@types/web-push": "^3.6.4",
    "@types/zxcvbn": "^4.4.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "hash-wasm": "^4.11.0",
    "helmet": "^8.2.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.395.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.1.0",
    "test": "^3.3.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.22.4",
    "web-push": "^3.6.7",
    "ws": "^8.17.0",
    "zod": "^4.4.3",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-alpha.18",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.1",
    "k6": "^0.0.0",
    "rollup": "^4.62.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.0.0-alpha.18",
    "typescript": "^5.4.5",
    "vite": "^8.1.3",
    "vite-plugin-top-level-await": "^1.2.2",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "@signalapp/libsignal-client@0.62.0": true,
    "@swc/core@1.16.0": true
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
