{
  "name": "velum",
  "version": "2.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --exclude 'server/db/**' --exclude 'server/logs/**' server/index.ts",
    "start": "node dist/server.cjs",
    "build": "tsx scripts/update-build-version.ts && vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && tsx scripts/package-ota.ts",
    "ota:package": "tsx scripts/package-ota.ts",
    "lint": "tsc --noEmit --skipLibCheck && tsc -p tsconfig.server.json --noEmit",
    "heal": "tsx server/self-healing.ts --fix",
    "heal:report": "tsx server/self-healing.ts --report",
    "dev:server": "tsx watch server/index.ts",
    "cli": "tsx cli/v2/index.ts",
    "cli:v2": "tsx cli/v2/index.ts",
    "backup": "bash server/v2/scripts/backup.sh",
    "restore": "bash server/v2/scripts/restore.sh",
    "sync-to-cloud": "bash server/v2/scripts/sync-to-cloud.sh",
    "sync-from-cloud": "bash server/v2/scripts/sync-from-cloud.sh",
    "test": "vitest run",
    "secrets:set": "tsx scripts/secrets-manager.ts set",
    "secrets:get": "tsx scripts/secrets-manager.ts get",
    "secrets:list": "tsx scripts/secrets-manager.ts list",
    "secrets:generate-env": "tsx scripts/secrets-manager.ts generate-env",
    "secrets:status": "tsx scripts/secrets-manager.ts status",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "db:migrate": "drizzle-kit migrate",
    "db:schema:apply": "tsx scripts/apply-pending-schema.ts",
    "messages:clear-legacy": "bash server/v2/scripts/clear-legacy-messages.sh",
    "dev:start": "bash scripts/dev-start.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "security:scan": "tsx scripts/security-scan.ts",
    "ddos:recovery": "bash scripts/ddos-recovery.sh",
    "ddos:simulate": "bash scripts/simulate-ddos.sh",
    "dev:resilient": "PG_MAX_POOL=100 npm run dev:start",
    "monitor:server": "bash scripts/monitor-server.sh"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@braintree/sanitize-url": "^7.1.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@esbuild/linux-arm64": "^0.28.2",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/geoip-lite": "^1.4.4",
    "@types/web-push": "^3.6.4",
    "@types/zxcvbn": "^4.4.5",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dexie": "^4.4.5",
    "dompurify": "^3.4.15",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.3.0",
    "geoip-lite": "^2.0.3",
    "hash-wasm": "^4.11.0",
    "helmet": "^8.2.0",
    "howler": "^2.2.4",
    "lucide-react": "^0.395.0",
    "opossum": "^10.0.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-sounds": "^1.0.30",
    "redis": "^6.1.0",
    "simple-notification-sounds": "^1.0.0",
    "tsx": "^4.22.4",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.17.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-alpha.18",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.1",
    "k6": "^0.0.0",
    "rollup": "^4.62.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.0.0-alpha.18",
    "typescript": "^5.4.5",
    "vite": "^8.1.3",
    "vite-plugin-top-level-await": "^1.2.2",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "@signalapp/libsignal-client@0.62.0": true,
    "@swc/core@1.16.0": true
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
